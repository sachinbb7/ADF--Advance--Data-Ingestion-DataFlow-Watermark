									"type": "Expression"
								},
								"ds_container": "rejected"
							},
							"SummarySink": {
								"ds_folder": "store_product_summary",
								"ds_file": {
									"value": "@concat(\n    'store_product_summary_',\n    formatDateTime(utcNow(),'yyyyMMdd'),\n    '.csv'\n)",
									"type": "Expression"
								},
								"ds_container": "curated"
							}
						}
					},
					"compute": {
						"coreCount": 8,
