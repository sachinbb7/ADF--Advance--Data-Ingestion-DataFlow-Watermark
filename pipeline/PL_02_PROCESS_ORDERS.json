					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT\n    MAX(last_processed_timestamp) AS previous_hwm\nFROM dbo.etl_watermark\nWHERE source_name = 'orders';",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azuresql",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Data flow1",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "Lookup HWM",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "DataFlowTransformations",
						"type": "DataFlowReference",
						"parameters": {
							"pl_hwm": "'1900-01-01 00:00:00.000'"
						},
						"datasetParameters": {
							"CuratedOrdersSink": {
								"ds_folder": "orders",
								"ds_file": {
									"value": "@concat(\n    'orders_',\n    formatDateTime(utcNow(),'yyyyMMdd'),\n    '.csv'\n)",
									"type": "Expression"
								},
								"ds_container": "curated"
							},
							"InvalidOrdersSink": {
